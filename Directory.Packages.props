<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <DekafPackageVersion Condition="'$(DekafPackageVersion)' == ''">1.27.0</DekafPackageVersion>
    <PackageValidationBaselineVersion Condition="'$(PackageValidationBaselineVersion)' == ''">$(DekafPackageVersion)</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Apache.Avro" Version="1.12.2" />
    <PackageVersion Include="AlibabaCloud.SDK.Kms20160120" Version="2.2.2" />
    <PackageVersion Include="Aliyun.Credentials" Version="1.5.4" />
    <PackageVersion Include="Aspire.Hosting" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.5" />
    <PackageVersion Include="AWSSDK.DynamoDBv2" Version="4.1.0" />
    <PackageVersion Include="AWSSDK.KeyManagementService" Version="4.1.0" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Security.KeyVault.Keys" Version="4.10.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
    <PackageVersion Include="BenchmarkDotNet.Diagnostics.Windows" Version="0.16.0-preview.2" />
    <PackageVersion Include="Confluent.Kafka" Version="2.16.0" />
    <PackageVersion Include="Confluent.SchemaRegistry" Version="2.16.0" />
    <PackageVersion Include="Confluent.SchemaRegistry.Serdes.Avro" Version="2.16.0" />
    <PackageVersion Include="Confluent.SchemaRegistry.Serdes.Json" Version="2.16.0" />
    <PackageVersion Include="Confluent.SchemaRegistry.Serdes.Protobuf" Version="2.16.0" />
    <PackageVersion Include="Dekaf" Version="$(DekafPackageVersion)" />
    <PackageVersion Include="Dekaf.Abstractions" Version="$(DekafPackageVersion)" />
    <PackageVersion Include="GitVersion.MsBuild" Version="6.8.2" />
    <PackageVersion Include="Google.Cloud.Kms.V1" Version="3.27.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.Core.Api" Version="2.85.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.85.0" />
    <PackageVersion Include="Jsonata.Net.Native" Version="3.0.0" />
    <PackageVersion Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.3" />
    <PackageVersion Include="ModularPipelines" Version="3.2.8" />
    <PackageVersion Include="ModularPipelines.DotNet" Version="3.2.8" />
    <PackageVersion Include="ModularPipelines.Git" Version="3.2.8" />
    <PackageVersion Include="ModularPipelines.GitHub" Version="3.2.8" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="OpenTelemetry" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="Polyfill" Version="11.4.5" />
    <PackageVersion Include="protobuf-net.Reflection" Version="3.4.40" />
    <PackageVersion Include="Reservoir" Version="1.10.0" />
    <PackageVersion Include="SharpFuzz" Version="2.3.0" />
    <PackageVersion Include="Snappier" Version="1.3.1" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Kafka" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Redpanda" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Toxiproxy" Version="4.16.0" />
    <PackageVersion Include="ToxiproxyNetCore" Version="1.0.50" />
    <PackageVersion Include="TUnit" Version="1.84.0" />
    <PackageVersion Include="TUnit.Logging.Microsoft" Version="1.84.0" />
    <PackageVersion Include="Verify.TUnit" Version="33.4.0" />
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <!--
    .NET platform packages (Microsoft.Extensions.*, EF Core, System.*) follow the target framework's major version:
    net11.0 takes the 11.x line; net10.0 and netstandard2.0 stay on 10.x. renovate.json blocks major bumps for these.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="11.0.0" />
    <PackageVersion Include="System.IO.Hashing" Version="11.0.0" />
    <PackageVersion Include="System.IO.Pipelines" Version="11.0.0" />
    <PackageVersion Include="System.Text.Json" Version="11.0.0" />
    <PackageVersion Include="System.Threading.Channels" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net11.0'">
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.15" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.14" />
    <PackageVersion Include="System.IO.Pipelines" Version="10.0.14" />
    <PackageVersion Include="System.Text.Json" Version="10.0.14" />
    <PackageVersion Include="System.Threading.Channels" Version="10.0.9" />
  </ItemGroup>
  <ItemGroup>
    <!-- Transitive pin: the e_sqlite3 versions EF Core's Sqlite provider pulls in carry GHSA-2m69-gcr7-jv3q. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>
</Project>
