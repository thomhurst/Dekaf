+using System.Diagnostics;
+
+namespace Dekaf.Benchmarks;
+
+internal static class GatePrimer
+{
+    private sealed class State
+    {
+        public readonly ManualResetEvent Reached = new(false);
+        public int CallbackThreadId;
+    }
+
+    public static object Warm()
+    {
+        var mode = Environment.GetEnvironmentVariable("ADMIN_GATE_PRIMER_MODE");
+        if (mode is not ("idle" or "wake")) throw new ArgumentException("Unknown gate primer mode.");
+        var threadId = Environment.CurrentManagedThreadId;
+        var started = Stopwatch.GetTimestamp();
+        var cycles = 0;
+        var callbacks = 0;
+        var lastCallbackThreadId = 0;
+        while (Stopwatch.GetElapsedTime(started).TotalSeconds < 60)
+        {
+            Thread.Sleep(1200);
+            cycles++;
+            if (mode == "idle") continue;
+            var state = new State();
+            var timer = new Timer(static value =>
+            {
+                var current = (State)value!;
+                current.CallbackThreadId = Environment.CurrentManagedThreadId;
+                current.Reached.Set();
+            }, state, 0, Timeout.Infinite);
+            var reached = false;
+            var completedDrain = false;
+            try
+            {
+                reached = state.Reached.WaitOne(TimeSpan.FromSeconds(30));
+            }
+            finally
+            {
+                // Failed drains keep callback state and its signal handles alive.
+                var drained = new ManualResetEvent(false);
+                completedDrain = timer.Dispose(drained) && drained.WaitOne(TimeSpan.FromSeconds(30));
+                if (completedDrain)
+                {
+                    drained.Dispose();
+                    state.Reached.Dispose();
+                }
+            }
+            if (!reached || !completedDrain)
+                throw new InvalidOperationException("Gate primer callback did not complete and drain.");
+            callbacks++;
+            lastCallbackThreadId = state.CallbackThreadId;
+        }
+        if (threadId != Environment.CurrentManagedThreadId)
+            throw new InvalidOperationException("Gate primer changed the calling thread.");
+        return new
+        {
+            Mode = mode, RequestedSeconds = 60,
+            Seconds = Stopwatch.GetElapsedTime(started).TotalSeconds,
+            Cycles = cycles, Callbacks = callbacks,
+            CallingThreadId = threadId, FinalCallingThreadId = Environment.CurrentManagedThreadId,
+            LastCallbackThreadId = lastCallbackThreadId, Drained = true
+        };
+    }
+}
