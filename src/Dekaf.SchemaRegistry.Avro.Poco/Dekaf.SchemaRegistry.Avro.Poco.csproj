<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Dekaf.SchemaRegistry.Avro.Poco</PackageId>
    <Description>Source-generated, allocation-safe POCO Avro serialization for Dekaf Schema Registry</Description>
    <PackageTags>kafka;schema-registry;avro;serialization;source-generator;aot</PackageTags>
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Apache.Avro" />
    <ProjectReference Include="..\Dekaf.SchemaRegistry\Dekaf.SchemaRegistry.csproj" />
    <ProjectReference Include="..\Dekaf.SchemaRegistry.Avro\Dekaf.SchemaRegistry.Avro.csproj" />
    <ProjectReference Include="..\Dekaf.SchemaRegistry.Avro.Poco.Generator\Dekaf.SchemaRegistry.Avro.Poco.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <None Include="..\Dekaf.SchemaRegistry.Avro.Poco.Generator\bin\$(Configuration)\netstandard2.0\*.dll"
          Exclude="..\Dekaf.SchemaRegistry.Avro.Poco.Generator\bin\$(Configuration)\netstandard2.0\Microsoft.CodeAnalysis*.dll;
                   ..\Dekaf.SchemaRegistry.Avro.Poco.Generator\bin\$(Configuration)\netstandard2.0\System.Collections.Immutable.dll;
                   ..\Dekaf.SchemaRegistry.Avro.Poco.Generator\bin\$(Configuration)\netstandard2.0\System.Reflection.Metadata.dll;
                   ..\Dekaf.SchemaRegistry.Avro.Poco.Generator\bin\$(Configuration)\netstandard2.0\System.Text.Encoding.CodePages.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

</Project>
