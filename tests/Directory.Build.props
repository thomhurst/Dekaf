<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == 'net10.0' and '$(TargetFrameworks)' == ''"></TargetFramework>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net10.0;net11.0</TargetFrameworks>
    <!-- Allow underscores in test method names -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <!-- .NET 11 SDK analyzers: tests bound waits with Task.WhenAny + Task.Delay on purpose (CA2027), and
         JsonSerializerOptions.GetTypeInfo<T>() (CA2263) does not exist on net10.0. -->
    <NoWarn>$(NoWarn);CA2027;CA2263</NoWarn>
    <!-- Enable new Microsoft Testing Platform experience -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <!--
    Verify 33+ ships SponsorCheck in owner mode and fails the build (SC021) unless the consumer
    declares a sponsorship or a publisher-defined exemption. Dekaf is MIT-licensed open source
    with no revenue, so it claims the OpenSource exemption. The exemption is time-bounded
    (at most 12 months out); computing the end month at evaluation time keeps it 6 months in
    the future on every build, so it never expires and never needs a manual bump.
  -->
  <PropertyGroup>
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>$([System.DateTime]::UtcNow.AddMonths(6).ToString('yyyy-MM'))</Verify_SponsorshipExemptionUntil>
  </PropertyGroup>

</Project>
