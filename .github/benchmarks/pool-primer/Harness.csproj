    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Dekaf.Benchmarks</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="Program.cs" />
    <Compile Include="RuntimeLogger.cs" />
    <PackageReference Include="BenchmarkDotNet" />
    <Reference Include="Dekaf"><HintPath>$(ArchivedHost)/Dekaf.dll</HintPath></Reference>
    <Reference Include="Reservoir"><HintPath>$(ArchivedHost)/Reservoir.dll</HintPath></Reference>
  </ItemGroup>
</Project>
